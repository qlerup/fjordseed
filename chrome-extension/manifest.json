{
  "manifest_version": 3,
  "name": "FjordSeed – Send torrent",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "Højreklik på et NordicBytes-downloadlink og åbn det i FjordSeeds manuelle dialog.",
  "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"},
  "permissions": ["contextMenus", "storage", "scripting"],
  "host_permissions": ["https://nordicbytes.org/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "FjordSeed", "default_popup": "popup.html"}
}
